VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
NETLIFY_SITE_ID=
STRIPE_CONFIG={"secretKey":"","publishableKey":"","webhookSecret":""}

# Turso — content kit persistence (shared across pipeline)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: webhook URL for support request notifications
VITE_SUPPORT_WEBHOOK_URL=
SIMPLE_ANALYTICS_API_KEY=

# Contact form (Resend — Client Dashboard's business account, not the frontend's)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Installment schedule API (Client Dashboard / isyourwebsitegood.com).
# The two "get-installment-schedule" and "issue-installment-invoice"
# Netlify functions in this dashboard proxy through to the Client
# Dashboard API using the shared secret. Silently skips rendering the
# Upcoming Installments card when unset.
INSTALLMENT_API_BASE_URL=
INSTALLMENT_API_SECRET=
