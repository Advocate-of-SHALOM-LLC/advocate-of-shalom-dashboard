VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
NETLIFY_SITE_ID=
STRIPE_CONFIG={"secretKey":"","publishableKey":"","webhookSecret":""}

# Turso — the agency database (monthly reports, Lighthouse checks; shared across pipeline)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: webhook URL for support request notifications
VITE_SUPPORT_WEBHOOK_URL=
SIMPLE_ANALYTICS_API_KEY=

# Contact form (Resend — Client Dashboard's business account, not the frontend's)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Installment schedule API (Client Dashboard / isyourwebsitegood.com).
# The two "get-installment-schedule" and "issue-installment-invoice"
# Netlify functions in this dashboard proxy through to the Client
# Dashboard API using the shared secret. Silently skips rendering the
# Upcoming Installments card when unset.
INSTALLMENT_API_BASE_URL=
INSTALLMENT_API_SECRET=

# Google PageSpeed Insights API key for the monthly Lighthouse test
# (lighthouse-check). PSI_API_KEY is read too. Without it there is no
# speed and quality section in the reports.
GOOGLE_PAGESPEED_API_KEY=

# Calendar months for reports are counted in this timezone.
CLIENT_TIMEZONE=America/Denver

# The client's own private records (Clients and Profit & Loss) — a separate
# Turso database from the agency one. Tables are created on first use.
RECORDS_TURSO_CONFIG={"databaseUrl":"","authToken":""}
